# --- Security ---
SECRET_KEY=change-me
COOKIE_SECURE=false #Local development uses http://localhost . HTTPS-only cookies would break login/session locally.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/monster_manager

# --- Demo / Seeding ---
# These flags control an optional demo data seeding script used for
# local development and portfolio review.
#
# The script creates or updates fixed demo users (ADMIN / DM / PLAYER)
# in an idempotent way.
#
# Safety:
# - Seeding is disabled by default.
# - The script will refuse to run unless ALLOW_SEED_DEMO=1 is explicitly set.
#
# RESET_DEMO_PASSWORDS can be enabled to reapply the demo password
# when re-running the script.
ALLOW_SEED_DEMO=0
RESET_DEMO_PASSWORDS=0

# --- OAuth (optional / unused for now) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=